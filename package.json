{
  "name": "2md",
  "description": "Converts GitHub repositories, directories, or specific files into a single markdown document for easy consumption by LLMs or documentation tools.",
  "version": "0.0.1",
  "type": "module",
  "repository": "github:o-az/2md",
  "bin": {
    "2md": "./src/cli.mjs"
  },
  "files": [
    "src/cli.mjs"
  ],
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json",
    "#wrangler.json": "./wrangler.json",
    "#README.md": "./.github/README.md"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "NODE_ENV='production' wrangler --config='wrangler.json' deploy",
    "check": "biome check . --write --unsafe",
    "check:types": "tsgo --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "./scripts/checks.sh",
    "types": "wrangler types --env-interface='CloudflareBindings' --env-file='.env.example'",
    "prepublishOnly": "bun run build:cli"
  },
  "dependencies": {
    "hono": "^4.11.9",
    "marked": "^17.0.1",
    "pretty-cache-header": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@cloudflare/vite-plugin": "^1.32.3",
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260415.1",
    "@vitejs/devtools": "^0.1.13",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "oxlint-tsgolint": "^0.11.5",
    "typed-query-selector": "^2.12.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.12"
}
