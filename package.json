{
  "name": "2md",
  "version": "0.0.1",
  "description": "Converts GitHub repositories, directories, or specific files into a single markdown document for easy consumption by LLMs or documentation tools.",
  "license": "MIT",
  "repository": "github:o-az/2md",
  "bin": {
    "2md": "./src/cli.mjs"
  },
  "files": [
    "src/cli.mjs"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json",
    "#wrangler.json": "./wrangler.json",
    "#README.md": "./.github/README.md"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "NODE_ENV='production' wrangler --config='wrangler.json' deploy",
    "format": "oxfmt --config='oxfmt.config.ts' --write",
    "lint": "oxlint --config='oxlint.config.ts' --type-aware --type-check --fix-dangerously",
    "check": "bun format && bun lint",
    "check:types": "tsgo --project tsconfig.json --noEmit",
    "test": "vitest run",
    "types": "wrangler types --env-interface='CloudflareBindings' --env-file='.env.example'",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "hono": "^4.12.28",
    "marked": "^18.0.5",
    "pretty-cache-header": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^5.20260707.1",
    "@j178/prek": "^0.4.8",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/devtools": "^0.3.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "simple-git-hooks": "^2.13.1",
    "typed-query-selector": "^2.12.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun prek run --all-files --config='.github/.pre-commit.yml' && bun check"
  },
  "packageManager": "bun@1.3.14"
}
